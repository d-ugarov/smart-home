{
  // Example flat: not a real home. Settings and secrets live here; the house itself (controllers, entities, menu,
  // rules) is in home/*.json. Both run locally on simulated controllers and a fake bot, nothing leaves the machine.
  // The real home: appsettings of the server, its house files in the private configs repository.
  "Logging": {
    "LogLevel": {
      "Default": "Trace",
      "Microsoft": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": { "Url": "http://0.0.0.0:5075" }
    }
  },
  "HomeConfigDirectory": "home",
  // The state of the house and scheduled actions; on the server - outside the deployed files.
  "Storage": {
    "DatabasePath": "data/home.db"
  },
  "Automation": {
    "Enabled": true,
    "SchedulesEnabled": true
  },
  // The leak sensor of a bathroom does not close the valves while it is being cleaned.
  "Cleaning": {
    "Enabled": true
  },
  "MegaD": {
    "UseSimulator": true
  },
  "Telegram": {
    "BotToken": "",
    "AllowedUsers": [ 123456789 ],
    "NotificationChatId": 123456789,
    "UseFakeBot": true
  }
}
