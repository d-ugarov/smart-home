<?xml version="1.0" encoding="utf-8" ?>
<!--
  Plain text diagnostic log, files only. Owner notifications are not NLog's job.
  This file is for local runs; the server keeps its own copy (publish does not ship it) - there only
  logDirectory changes: /var/home-server-logs/logs.
-->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Warn"
      internalLogFile="${tempdir}/MegaDTelegramRemoteControl/nlog-internal.log">

    <variable name="logDirectory" value="${basedir}/logs" />

    <targets async="true">
        <target xsi:type="File" name="app"
                fileName="${var:logDirectory}/app-${shortdate}.log"
                maxArchiveDays="30"
                layout="${longdate}|${level:uppercase=true}|${logger:shortName=true}|${message:withexception=true}" />

        <target xsi:type="File" name="requests"
                fileName="${var:logDirectory}/requests-${shortdate}.log"
                maxArchiveDays="30"
                layout="${longdate}|${message:withexception=true}" />
    </targets>

    <rules>
        <!-- Framework noise: startup/shutdown messages and problems only. -->
        <logger name="Microsoft.*" finalMinLevel="Warn" />
        <logger name="System.Net.Http.*" finalMinLevel="Warn" />
        <logger name="Microsoft.Hosting.Lifetime" finalMinLevel="Info" />

        <!-- Every HTTP request to the server (MegaD events): own file. -->
        <logger name="MegaDTelegramRemoteControl.Infrastructure.Middlewares.RequestLoggingMiddleware" writeTo="requests" final="true" />

        <logger name="*" minlevel="Trace" writeTo="app" />
    </rules>
</nlog>
