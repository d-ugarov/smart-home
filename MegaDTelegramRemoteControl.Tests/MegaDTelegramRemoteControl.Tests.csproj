<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="NSubstitute" Version="6.2.0" />
    <PackageReference Include="NUnit" Version="5.0.0" />
    <PackageReference Include="NUnit.Analyzers" Version="4.15.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MegaDTelegramRemoteControl\MegaDTelegramRemoteControl.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="TestData\**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\MegaDTelegramRemoteControl\nlog.config" Link="TestData\repo-nlog.config" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\MegaDTelegramRemoteControl\appsettings.json" Link="TestData\example-appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
