{
  // Example flat: not a real home. Used for local runs and as the input of the tests, so it covers every
  // kind of rule and menu item the server supports. A real home goes to appsettings.Development.json (not in git).
  "Logging": {
    "IncludeScopes": false,
    "LogLevel": {
      "Default": "Trace",
      "Microsoft": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "KestrelConfig": {
    "Port": 5075
  },
  "DevicesConfig": {
    "Devices": [
      {
        "Id": "1",
        "Name": "MegaD-1",
        "Ip": "http://192.168.0.11",
        "Pwd": "sec",
        "DevicePorts": [
          { "Id": "0", "Type": "IN", "Name": "Hall switch" },
          { "Id": "1", "Type": "IN", "Name": "Kitchen switch" },
          { "Id": "2", "Type": "IN", "Name": "Bathroom switch" },
          { "Id": "3", "Type": "IN", "Name": "Bedroom switch left" },
          { "Id": "4", "Type": "IN", "Name": "Bedroom switch right" },
          // Pulse water meter: no rules, the server answers 204.
          { "Id": "5", "Type": "IN", "Name": "Water meter" },
          // Leak sensor: no rules (the controller closes the valves itself), shown in the menu.
          { "Id": "6", "Type": "IN", "Name": "Leak sensor", "InOutSWModeIcons": { "On": "🔴", "Off": "🔘" } },
          { "Id": "7", "Type": "OUT", "Name": "Hall light", "OutMode": "SW", "InOutSWModeIcons": { "On": "🟢", "Off": "🔘" } },
          { "Id": "8", "Type": "OUT", "Name": "Kitchen light", "OutMode": "SW", "InOutSWModeIcons": { "On": "🟢", "Off": "🔘" } },
          { "Id": "9", "Type": "OUT", "Name": "Kitchen apron", "OutMode": "SW", "InOutSWModeIcons": { "On": "🟢", "Off": "🔘" } },
          { "Id": "10", "Type": "OUT", "Name": "Bathroom light", "OutMode": "SW", "InOutSWModeIcons": { "On": "🟢", "Off": "🔘" } },
          { "Id": "11", "Type": "OUT", "Name": "Bathroom fan", "OutMode": "SW", "InOutSWModeIcons": { "On": "🟢", "Off": "🔘" } },
          { "Id": "12", "Type": "OUT", "Name": "Valves open", "OutMode": "SW", "InOutSWModeIcons": { "On": "🟢", "Off": "🔘" } },
          { "Id": "13", "Type": "OUT", "Name": "Valves close", "OutMode": "SW", "InOutSWModeIcons": { "On": "🟢", "Off": "🔘" } },
          // No icons: the menu shows the state as text.
          { "Id": "14", "Type": "OUT", "Name": "Main contactor", "OutMode": "SW" }
        ]
      },
      {
        "Id": "2",
        "Name": "MegaD-2",
        "Ip": "http://192.168.0.12",
        "Pwd": "sec",
        "DevicePorts": [
          { "Id": "0", "Type": "IN", "Name": "Living room switch" },
          { "Id": "1", "Type": "IN", "Name": "Living room switch 2" },
          { "Id": "7", "Type": "OUT", "Name": "Living room chandelier", "OutMode": "SW", "InOutSWModeIcons": { "On": "🟢", "Off": "🔘" } },
          { "Id": "8", "Type": "OUT", "Name": "Living room spots", "OutMode": "SW", "InOutSWModeIcons": { "On": "🟢", "Off": "🔘" } },
          { "Id": "9", "Type": "OUT", "Name": "Bedroom light", "OutMode": "SW", "InOutSWModeIcons": { "On": "🟢", "Off": "🔘" } },
          { "Id": "10", "Type": "OUT", "Name": "Bedroom night light", "OutMode": "SW", "InOutSWModeIcons": { "On": "🟢", "Off": "🔘" } },
          { "Id": "11", "Type": "OUT", "Name": "Floor heating", "OutMode": "SW", "InOutSWModeIcons": { "On": "🟢", "Off": "🔘" } }
        ]
      }
    ]
  },
  "HomeMapConfig": {
    "Locations": [
      {
        "Name": "🏠 Rooms",
        "SubLocations": [
          {
            "Name": "Hall",
            "Items": [
              { "DeviceId": "1", "PortId": "7", "CustomName": "Light" }
            ]
          },
          {
            "Name": "Kitchen",
            "Items": [
              { "DeviceId": "1", "PortId": "8", "CustomName": "Light" },
              { "DeviceId": "1", "PortId": "9", "CustomName": "Apron" }
            ]
          },
          {
            "Name": "Bathroom",
            "Items": [
              { "DeviceId": "1", "PortId": "10", "CustomName": "Light" },
              { "DeviceId": "1", "PortId": "11", "CustomName": "Fan" }
            ],
            "SubLocations": [
              {
                "Name": "💧 Water",
                "Items": [
                  { "DeviceId": "1", "PortId": "6", "CustomName": "Leak sensor" },
                  { "DeviceId": "1", "PortId": "12", "CustomName": "Open valves" },
                  { "DeviceId": "1", "PortId": "13", "CustomName": "Close valves" }
                ]
              }
            ]
          },
          {
            // Items without CustomName are shown with the port name.
            "Name": "Living room",
            "Items": [
              { "DeviceId": "2", "PortId": "7" },
              { "DeviceId": "2", "PortId": "8" }
            ]
          },
          {
            "Name": "Bedroom",
            "Items": [
              { "DeviceId": "2", "PortId": "9", "CustomName": "Light" },
              { "DeviceId": "2", "PortId": "10", "CustomName": "Night light" }
            ]
          }
        ]
      },
      {
        // Every OUT port of every controller that is on right now.
        "Name": "✔️ Now on",
        "ItemsConditions": [
          { "Type": "PortOutCurrentStatus", "Status": "On" }
        ]
      },
      {
        // The same ports may appear on several pages.
        "Name": "🛠 Engineering",
        "Items": [
          { "DeviceId": "1", "PortId": "14" },
          { "DeviceId": "2", "PortId": "11" },
          { "DeviceId": "1", "PortId": "6" },
          { "DeviceId": "1", "PortId": "12" },
          { "DeviceId": "1", "PortId": "13" }
        ]
      }
    ]
  },
  "AutomationConfig": {
    "Triggers": [
      // Hall: click switches the light, long press turns off every light in the flat (both controllers;
      // Off is skipped for lights that are already off).
      {
        "SourcePortState": { "DeviceId": "1", "PortId": "0", "Status": { "InPortCommands": [ "KeyPressed", "Click" ] } },
        "DestinationPortStates": [
          { "DeviceId": "1", "PortId": "7", "Action": { "SWCommand": "Switch" } }
        ],
        "Result": "DoNothing"
      },
      {
        "SourcePortState": { "DeviceId": "1", "PortId": "0", "Status": { "InPortCommands": [ "LongClick" ] } },
        "DestinationPortStates": [
          { "DeviceId": "1", "PortId": "7", "Action": { "SWCommand": "Off" } },
          { "DeviceId": "1", "PortId": "8", "Action": { "SWCommand": "Off" } },
          { "DeviceId": "1", "PortId": "9", "Action": { "SWCommand": "Off" } },
          { "DeviceId": "1", "PortId": "10", "Action": { "SWCommand": "Off" } },
          { "DeviceId": "2", "PortId": "7", "Action": { "SWCommand": "Off" } },
          { "DeviceId": "2", "PortId": "8", "Action": { "SWCommand": "Off" } },
          { "DeviceId": "2", "PortId": "9", "Action": { "SWCommand": "Off" } },
          { "DeviceId": "2", "PortId": "10", "Action": { "SWCommand": "Off" } }
        ],
        "Result": "DoNothing"
      },
      // Kitchen: click - light, double click - apron.
      {
        "SourcePortState": { "DeviceId": "1", "PortId": "1", "Status": { "InPortCommands": [ "KeyPressed", "Click" ] } },
        "DestinationPortStates": [
          { "DeviceId": "1", "PortId": "8", "Action": { "SWCommand": "Switch" } }
        ],
        "Result": "DoNothing"
      },
      {
        "SourcePortState": { "DeviceId": "1", "PortId": "1", "Status": { "InPortCommands": [ "DoubleClick" ] } },
        "DestinationPortStates": [
          { "DeviceId": "1", "PortId": "9", "Action": { "SWCommand": "Switch" } }
        ],
        "Result": "DoNothing"
      },
      // Bathroom: light off -> light and fan on, stop (IsFinal); otherwise -> light off.
      {
        "SourcePortState": { "DeviceId": "1", "PortId": "2", "Status": { "InPortCommands": [ "KeyPressed", "Click" ] } },
        "AdditionalConditions": {
          "Ports": [ { "DeviceId": "1", "PortId": "10" } ],
          "Type": "StatesAreEqual",
          "Status": "Off"
        },
        "DestinationPortStates": [
          { "DeviceId": "1", "PortId": "10", "Action": { "SWCommand": "On" } },
          { "DeviceId": "1", "PortId": "11", "Action": { "SWCommand": "On" }, "DelayBeforeActionInMilliseconds": 100 }
        ],
        "Result": "DoNothing",
        "IsFinal": true
      },
      {
        "SourcePortState": { "DeviceId": "1", "PortId": "2", "Status": { "InPortCommands": [ "KeyPressed", "Click" ] } },
        "DestinationPortStates": [
          { "DeviceId": "1", "PortId": "10", "Action": { "SWCommand": "Off" } }
        ],
        "Result": "DoNothing"
      },
      // Bedroom left: lamps in different states -> both off, stop; otherwise switch both.
      {
        "SourcePortState": { "DeviceId": "1", "PortId": "3", "Status": { "InPortCommands": [ "KeyPressed", "Click" ] } },
        "AdditionalConditions": {
          "Ports": [ { "DeviceId": "2", "PortId": "9" }, { "DeviceId": "2", "PortId": "10" } ],
          "Type": "StatesNotEqual"
        },
        "DestinationPortStates": [
          { "DeviceId": "2", "PortId": "9", "Action": { "SWCommand": "Off" } },
          { "DeviceId": "2", "PortId": "10", "Action": { "SWCommand": "Off" } }
        ],
        "Result": "DoNothing",
        "IsFinal": true
      },
      {
        "SourcePortState": { "DeviceId": "1", "PortId": "3", "Status": { "InPortCommands": [ "KeyPressed", "Click" ] } },
        "DestinationPortStates": [
          { "DeviceId": "2", "PortId": "9", "Action": { "SWCommand": "Switch" } },
          { "DeviceId": "2", "PortId": "10", "Action": { "SWCommand": "Switch" } }
        ],
        "Result": "DoNothing"
      },
      // Bedroom right: any lamp on -> all off, stop; otherwise -> night light on.
      // Long press: StatesAnyEqual without Status (in master it means "all lamps in the same state").
      {
        "SourcePortState": { "DeviceId": "1", "PortId": "4", "Status": { "InPortCommands": [ "KeyPressed", "Click" ] } },
        "AdditionalConditions": {
          "Ports": [ { "DeviceId": "2", "PortId": "9" }, { "DeviceId": "2", "PortId": "10" } ],
          "Type": "StatesAnyEqual",
          "Status": "On"
        },
        "DestinationPortStates": [
          { "DeviceId": "2", "PortId": "9", "Action": { "SWCommand": "Off" } },
          { "DeviceId": "2", "PortId": "10", "Action": { "SWCommand": "Off" } }
        ],
        "Result": "DoNothing",
        "IsFinal": true
      },
      {
        "SourcePortState": { "DeviceId": "1", "PortId": "4", "Status": { "InPortCommands": [ "KeyPressed", "Click" ] } },
        "DestinationPortStates": [
          { "DeviceId": "2", "PortId": "10", "Action": { "SWCommand": "On" } }
        ],
        "Result": "DoNothing"
      },
      {
        "SourcePortState": { "DeviceId": "1", "PortId": "4", "Status": { "InPortCommands": [ "LongClick" ] } },
        "AdditionalConditions": {
          "Ports": [ { "DeviceId": "2", "PortId": "9" }, { "DeviceId": "2", "PortId": "10" } ],
          "Type": "StatesAnyEqual"
        },
        "DestinationPortStates": [
          { "DeviceId": "2", "PortId": "9", "Action": { "SWCommand": "Switch" } }
        ],
        "Result": "DoNothing"
      },
      // Living room (the switch is on the other controller): lamps in the same state -> switch both, stop;
      // otherwise -> both off. Double click -> spots after a pause.
      {
        "SourcePortState": { "DeviceId": "2", "PortId": "0", "Status": { "InPortCommands": [ "KeyPressed", "Click" ] } },
        "AdditionalConditions": {
          "Ports": [ { "DeviceId": "2", "PortId": "7" }, { "DeviceId": "2", "PortId": "8" } ],
          "Type": "StatesAreEqual"
        },
        "DestinationPortStates": [
          { "DeviceId": "2", "PortId": "7", "Action": { "SWCommand": "Switch" } },
          { "DeviceId": "2", "PortId": "8", "Action": { "SWCommand": "Switch" } }
        ],
        "Result": "DoNothing",
        "IsFinal": true
      },
      {
        "SourcePortState": { "DeviceId": "2", "PortId": "0", "Status": { "InPortCommands": [ "KeyPressed", "Click" ] } },
        "DestinationPortStates": [
          { "DeviceId": "2", "PortId": "7", "Action": { "SWCommand": "Off" } },
          { "DeviceId": "2", "PortId": "8", "Action": { "SWCommand": "Off" } }
        ],
        "Result": "DoNothing"
      },
      {
        "SourcePortState": { "DeviceId": "2", "PortId": "0", "Status": { "InPortCommands": [ "DoubleClick" ] } },
        "DestinationPortStates": [
          { "DeviceId": "2", "PortId": "8", "Action": { "SWCommand": "Switch" }, "DelayAfterActionInMilliseconds": 100 }
        ],
        "Result": "DoNothing"
      },
      // Living room switch 2: all lamps off -> chandelier on, and the controller also runs its own Act
      // (Result Default -> 204). Long press -> floor heating; a destination port that does not exist is skipped.
      {
        "SourcePortState": { "DeviceId": "2", "PortId": "1", "Status": { "InPortCommands": [ "KeyPressed", "Click" ] } },
        "AdditionalConditions": {
          "Ports": [ { "DeviceId": "2", "PortId": "7" }, { "DeviceId": "2", "PortId": "8" } ],
          "Type": "StatesNotEqual",
          "Status": "On"
        },
        "DestinationPortStates": [
          { "DeviceId": "2", "PortId": "7", "Action": { "SWCommand": "On" } }
        ],
        "Result": "Default"
      },
      {
        "SourcePortState": { "DeviceId": "2", "PortId": "1", "Status": { "InPortCommands": [ "LongClick" ] } },
        "DestinationPortStates": [
          { "DeviceId": "2", "PortId": "99", "Action": { "SWCommand": "Switch" } },
          { "DeviceId": "2", "PortId": "11", "Action": { "SWCommand": "Switch" } }
        ],
        "Result": "DoNothing"
      },
      // A rule for a controller that is not described is skipped at startup.
      {
        "SourcePortState": { "DeviceId": "9", "PortId": "0", "Status": { "InPortCommands": [ "Click" ] } },
        "DestinationPortStates": [
          { "DeviceId": "1", "PortId": "7", "Action": { "SWCommand": "Switch" } }
        ],
        "Result": "DoNothing"
      }
    ]
  },
  "TelegramConfig": {
    "BotAccessToken": "",
    "AllowedUsers": [ 123456789 ]
  },
  "TelegramProxyConfig": {
    "Host": null,
    "Username": null,
    "Password": null
  },
  "PlatformConfig": {
    "UseFakeDeviceConnector": true,
    "UseFakeTelegramBot": true
  },
  "InternalSchedulerConfig": {
    "Jobs": []
  },
  "AntiCaptchaConfig": {
    "ApiKey": "",
    "MaxSolveDurationInSeconds": 30
  },
  "KeeneticProxyConfig": {
    "Host": "",
    "Login": "",
    "Password": ""
  },
  "PesConfig": {
    "Clients": [
      {
        "Username": "",
        "Password": ""
      }
    ],
    "CommonConfig": {
      "CaptchaWebsiteKey": ""
    }
  }
}
